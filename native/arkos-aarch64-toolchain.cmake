# Existing GCC 9.3 toolchain + Debian 11 target headers/libraries.
# Keep target glibc requirements compatible with ArkOS (glibc 2.30).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(TH01_TARGET_SYSROOT "/opt/sysroot-debian11" CACHE PATH "ARM64 target sysroot")
set(TH01_CROSS_ROOT "/opt/toolchains/aarch64--glibc--stable-2020.08-1" CACHE PATH "Cross compiler root")
set(CMAKE_C_COMPILER "${TH01_CROSS_ROOT}/bin/aarch64-buildroot-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${TH01_CROSS_ROOT}/bin/aarch64-buildroot-linux-gnu-g++")
set(CMAKE_SYSROOT "${TH01_TARGET_SYSROOT}")
set(CMAKE_C_FLAGS_INIT "-isystem ${TH01_TARGET_SYSROOT}/usr/include/aarch64-linux-gnu")
set(CMAKE_CXX_FLAGS_INIT "-isystem ${TH01_TARGET_SYSROOT}/usr/include/aarch64-linux-gnu")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-B${TH01_TARGET_SYSROOT}/usr/lib/aarch64-linux-gnu/ -L${TH01_TARGET_SYSROOT}/usr/lib/aarch64-linux-gnu -L${TH01_TARGET_SYSROOT}/lib/aarch64-linux-gnu -Wl,-rpath-link,${TH01_TARGET_SYSROOT}/usr/lib/aarch64-linux-gnu -Wl,-rpath-link,${TH01_TARGET_SYSROOT}/lib/aarch64-linux-gnu -pie")
set(CMAKE_FIND_ROOT_PATH "${TH01_TARGET_SYSROOT}")
set(CMAKE_LIBRARY_ARCHITECTURE aarch64-linux-gnu)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${TH01_TARGET_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${TH01_TARGET_SYSROOT}/usr/lib/aarch64-linux-gnu/pkgconfig:${TH01_TARGET_SYSROOT}/usr/share/pkgconfig")
